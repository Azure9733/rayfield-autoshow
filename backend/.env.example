# Copy to .env for local development. Never commit .env.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rayfield_dev
BCRYPT_COST=10
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-characters
JWT_EXPIRES_IN=1h
