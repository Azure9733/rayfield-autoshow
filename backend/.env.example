# Copy to .env for local development. Never commit .env.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rayfield_dev
# TLS to the database: false for local Docker, true for Supabase (production).
DATABASE_SSL=false
BCRYPT_COST=10
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-characters
JWT_EXPIRES_IN=1h
# Used only by `npm run db:seed:admin` to create or reset the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
