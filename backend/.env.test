# Committed on purpose: points only at the throwaway Docker test database. No real secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/rayfield_test
# Minimum bcrypt cost: keeps the auth tests fast. Production uses the default (10).
BCRYPT_COST=4
# Dummy secret, only valid against the throwaway test database.
JWT_SECRET=test-only-jwt-secret-do-not-use-anywhere-else
JWT_EXPIRES_IN=1h
